{
	"packageManager": "pnpm@9.1.0",
	"private": true,
	"type": "module",
	"name": "skeetgen-cli",
	"scripts": {
		"build": "tsc && pnpm run gen && vite build",
		"compile": "pnpm run build && bun build --compile dist/cli.js --outfile dist/skeetgen-cli",
		"start": "node dist/cli.js",
		"gen": "wireit",
		"fmt": "prettier --cache --write ."
	},
	"wireit": {
		"gen": {
			"dependencies": [
				"gen:archive_css",
				"gen:archive_search_js"
			]
		},
		"gen:archive_css": {
			"command": "tailwindcss -i src_templates/styles/index.css -o gen/style.css --minify",
			"files": [
				"src_templates/styles/**/*.css"
			],
			"output": [
				"gen/style.css"
			]
		},
		"gen:archive_search_js": {
			"command": "esbuild src_templates/scripts/search.js --bundle --format=iife --outfile=gen/search.js --minify-syntax --minify-whitespace",
			"files": [
				"src_templates/scripts/search.js",
				"src_templates/scripts/dependencies/**/*.js"
			],
			"output": [
				"gen/search.js"
			]
		}
	},
	"dependencies": {
		"@akryum/flexsearch-es": "^0.7.32",
		"@ipld/car": "^5.3.0",
		"@ipld/dag-cbor": "^9.2.0",
		"@mary/bluesky-client": "npm:@jsr/mary__bluesky-client@^0.5.17",
		"multiformats": "^12.1.3",
		"p-map": "^7.0.2"
	},
	"devDependencies": {
		"@babel/core": "^7.24.6",
		"@babel/plugin-syntax-typescript": "^7.24.6",
		"@intrnl/jsx-to-string": "^0.1.6",
		"@rollup/plugin-babel": "^6.0.4",
		"@types/node": "^22.0.0",
		"bun": "^1.4.4",
		"esbuild": "^0.19.12",
		"prettier": "^3.2.5",
		"prettier-plugin-tailwindcss": "^0.5.14",
		"tailwindcss": "^3.4.3",
		"typescript": "^5.4.5",
		"vite": "^5.2.11",
		"wireit": "^0.14.4"
	},
	"bin": {
		"skeetgen-cli": "dist/cli.js"
	},
	"engines": {
		"node": ">=22"
	}
}
